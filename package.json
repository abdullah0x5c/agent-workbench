{
  "name": "agent-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Visual LLM agent orchestrator: wire agents, tools and memory on a canvas, run the graph and watch every reasoning step, tool call and prompt live.",
  "scripts": {
    "dev": "node server.mjs",
    "dev:next": "next dev",
    "build": "next build",
    "start": "NODE_ENV=production node server.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed": "node scripts/seed.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@uiw/react-codemirror": "^4.25.11",
    "@xyflow/react": "^12.11.6",
    "mongoose": "^9.10.1",
    "next": "15.5.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "15.5.25",
    "jsdom": "^30.1.0",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "vitest": "^5.0.1"
  }
}
