# ---- Database ----
# Local dev: the mongod service. Vercel: a MongoDB Atlas M0 connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/agent_workbench

# ---- Server (local only; Vercel ignores these) ----
PORT=3000
SOCKET_PORT=3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Realtime transport: "socket" locally, "sse" on Vercel.
NEXT_PUBLIC_REALTIME=socket

# ---- Providers ----
# opencode-go (OpenCode Go subscription). If unset, the app falls back to
# ~/.local/share/opencode/auth.json on this machine.
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1

# Default model and the model used by the LLM-as-judge scorer.
DEFAULT_MODEL=deepseek-v4.1-flash
JUDGE_MODEL=deepseek-v4.1-flash

# Mock provider is always available. Provider used when real is not allowed.
DEFAULT_PROVIDER=mock

# Safety: leave "false" on public deployments so visitors cannot spend your
# subscription. Set "true" only when DEMO_PASSWORD is set (or for local use).
ALLOW_REAL_PROVIDER=false

# ---- Demo gate ----
# If set, all pages/APIs require this password (cookie-based login).
DEMO_PASSWORD=

# ---- Engine limits ----
NODE_TIMEOUT_MS=10000
AGENT_MAX_ITERATIONS=8
AGENT_MAX_TOOL_CALLS=20
RUN_TIMEOUT_MS=300000
